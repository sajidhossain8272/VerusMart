# Database
# PostgreSQL connection string for Prisma
PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/verusmart?schema=public"

# Admin Panel Credentials (REQUIRED in production)
ADMIN_EMAIL="admin@verusmart.com"
ADMIN_PASSWORD="change-this-to-a-strong-password"
# Must be at least 32 characters in production
ADMIN_JWT_SECRET="change-this-to-a-random-32+character-secret"

# User Session Secret (for signing user session cookies)
SESSION_SECRET="change-this-to-a-random-32+character-secret"

# Next.js
NEXT_PUBLIC_SITE_URL="https://verusmart.com"